{
	"name": "celosiajs-boilerplate",
	"version": "1.0.0",
	"description": "CelosiaJS boilerplate",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "npm run clean:build && tsx ./scripts/build.ts",
		"prod": "cross-env NODE_ENV=production node --env-file=.env ./build/index.js",
		"clean:build": "rimraf ./build",
		"clean:logs": "rimraf ./Logs",
		"clean": "concurrently \"npm run clean:build\" \"npm run clean:logs\"",
		"start": "cross-env NODE_ENV=development tsx watch --env-file=.env ./src/index.ts",
		"lint:check": "eslint --cache",
		"lint:fix": "eslint --cache --fix",
		"prettier:check": "prettier -c \"./**/*.{ts,json,md,prettierrc}\"",
		"prettier:fix": "prettier -w \"./**/*.{ts,json,md,prettierrc}\"",
		"types:check": "tsc --noEmit",
		"check": "npm run lint:check && npm run prettier:check && npm run types:check",
		"fix": "npm run lint:fix && npm run prettier:fix && npm run types:check"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kennarddh/celosiajs-boilerplate.git"
	},
	"author": "kennarddh",
	"license": "MIT",
	"dependencies": {
		"@celosiajs/core": "^0.0.1-alpha.27",
		"@celosiajs/logging": "^0.0.1-alpha.26",
		"@prisma/client": "^6.2.1",
		"argon2": "^0.41.1",
		"compression": "^1.7.5",
		"cors": "^2.8.5",
		"helmet": "^8.0.0",
		"jsonwebtoken": "^9.0.2",
		"rate-limiter-flexible": "^5.0.4",
		"winston": "^3.17.0",
		"winston-daily-rotate-file": "^5.0.0",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@trivago/prettier-plugin-sort-imports": "^5.2.1",
		"@types/compression": "^1.7.5",
		"@types/cors": "^2.8.17",
		"@types/eslint": "^9.6.1",
		"@types/eslint__js": "^8.42.3",
		"@types/eslint-plugin-security": "^3.0.0",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^22.10.5",
		"@typescript-eslint/utils": "^8.19.1",
		"concurrently": "^9.1.2",
		"cross-env": "^7.0.3",
		"esbuild": "^0.23.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-typescript": "^3.7.0",
		"eslint-plugin-import-x": "^4.6.1",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-security": "^3.0.1",
		"globals": "^15.14.0",
		"jiti": "^2.4.2",
		"prettier": "^3.4.2",
		"prisma": "^6.2.1",
		"rimraf": "^6.0.1",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.19.1"
	}
}
